# ==========================================
# 資料庫時光機 (TimeMachine) 環境變數設定範本
# ==========================================

# --- MySQL 8.0 連線設定（設計 A、B、C 與基準線測試） ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=tm_user
DB_PASSWORD=tm_password
DB_NAME=timemachine

# --- MariaDB 11.4 連線設定（設計 D：原生系統版本化） ---
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3307
MARIADB_USER=tm_user
MARIADB_PASSWORD=tm_password
MARIADB_NAME=timemachine
